{
  "name": "cube-joystick-ad",
  "version": "5.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "predev": "node scripts/sync-assets.js",
    "dev": "node scripts/dev.js",
    "build": "bash build.sh",
    "check:build": "node scripts/check-build-report.mjs",
    "check:compat": "node scripts/compat-scan.mjs dist/index.html",
    "typecheck": "tsc --noEmit",
    "packages": "node scripts/build-packages.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:ui-editor-smoke",
    "test:unit": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:runtime": "node --test tests/runtime-lifecycle.test.mjs tests/simple-api.test.mjs",
    "test:serialization": "node --test tests/serialization.test.mjs tests/editor-history.test.mjs tests/scene-persistence.test.mjs",
    "test:project": "node --test tests/project-generator.test.mjs tests/dev-api.test.mjs tests/compat-scan.test.mjs",
    "test:geometry": "node --test tests/geometry-parity.test.mjs",
    "test:environment": "node --test tests/scene-environment.test.mjs",
    "test:particles": "node --test tests/particles.test.mjs tests/particle-shader.test.mjs",
    "test:ui": "node --test tests/ui-layout.test.mjs tests/ui-editor.test.mjs tests/render-defaults-parity.test.mjs",
    "test:ui-editor-smoke": "node scripts/test-ui-editor.js",
    "test:perf": "node --test --expose-gc tests/performance.test.mjs",
    "test:e2e": "ION_E2E=1 node --test --test-timeout=1800000 tests/build-regression.test.mjs",
    "test:visual": "node scripts/visual-regression.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs dist",
    "test:all": "npm run test && npm run test:perf && npm run test:e2e",
    "test:persistence": "node --test tests/scene-persistence.test.mjs tests/dev-server-data.test.mjs",
    "verify:persistence": "node scripts/verify-scene-persistence.mjs",
    "verify:editor": "node scripts/verify-editor.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/three": "^0.185.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
